# ==========================================
# TINOCLEAN LAUNDRY MANAGEMENT SYSTEM (.env)
# ==========================================

# App URL (used in email links & push notification URLs)
NEXT_PUBLIC_APP_URL=https://toon-laundry.vercel.app

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google SMTP Configuration (Gmail / Google Workspace App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=Tinoclean Laundry

# Web Push VAPID Keys (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@tinoclean.com

# OTP & Session Security Secret (generate a 32+ char random string)
OTP_HASH_SECRET=
CRON_SECRET=

# Optional: WhatsApp Business Cloud API (for automatic ticket DMs)
# If not set, staff can still send tickets in 1 tap via the "Send to Customer WhatsApp" button.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
